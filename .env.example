# Copia questo file in .env e compila i valori
#   cp .env.example .env

# Stringa segreta per le sessioni — CAMBIALA con qualcosa di lungo e casuale.
# Obbligatoria: senza, docker compose si rifiuta di partire e l'app userebbe
# un segreto casuale rigenerato a ogni riavvio (sessioni invalidate).
#   openssl rand -hex 32
SESSION_SECRET=metti_qui_una_stringa_lunga_e_casuale_almeno_32_caratteri

# Nome host con cui l'app è pubblicata dal reverse proxy
STEGO_HOST=stego.app.local

# Rete Docker condivisa con il reverse proxy
TRAEFIK_NETWORK=edge

# Numero di reverse proxy davanti all'app: 1 dietro Traefik, 0 se il
# container è esposto direttamente. Serve al rate limiter per leggere l'IP
# reale del client da X-Forwarded-For — con il valore sbagliato tutti i
# client dietro lo stesso proxy condividono lo stesso contatore — e alla
# sessione per capire da X-Forwarded-Proto di essere su HTTPS.
TRUST_PROXY=1

# Quando gira il backup notturno del DB (formato cron, dentro il container)
BACKUP_CRON=0 2 * * *

# ── LDAP / Active Directory ──────────────────────────────
# Anche con LDAP attivo gli account locali restano utilizzabili come
# fallback: una directory irraggiungibile non blocca l'accesso
# amministrativo.
# Tutti questi valori sono sovrascrivibili a caldo da Amministrazione → LDAP.
LDAP_ENABLED=false

# IP o hostname del server LDAP
LDAP_URL=ldap://ldap.example.local:389

# Service account per la ricerca utenti (sola lettura)
LDAP_BIND_DN=CN=svc_stego,OU=ServiceAccounts,DC=example,DC=local
LDAP_BIND_PASSWORD=password_del_service_account

# Base di ricerca degli utenti
LDAP_SEARCH_BASE=DC=example,DC=local

# Filtro: sAMAccountName = username Windows
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})

# false = accetta certificati self-signed (comune nelle directory interne)
LDAP_TLS_REJECT_UNAUTHORIZED=false

# ── OIDC / SSO (Keycloak, Authentik, Zitadel…) ───────────
# Anche con l'SSO attivo gli account locali restano utilizzabili.
# Tutti questi valori sono sovrascrivibili a caldo da
# Amministrazione → OIDC, che è anche il posto da cui provarli.
OIDC_ENABLED=false

# URL del realm/issuer: gli endpoint si leggono dalla sua discovery
# (/.well-known/openid-configuration), quindi non vanno elencati a mano.
OIDC_ISSUER=https://id.example.local/realms/master

OIDC_CLIENT_ID=stego
# Vuoto = client pubblico: l'autenticazione resta protetta da PKCE.
OIDC_CLIENT_SECRET=

# Deve combaciare con quello registrato sul provider. Se lasciato vuoto
# viene ricavato dalla richiesta: https://<STEGO_HOST>/auth/callback
OIDC_REDIRECT_URI=

# Etichetta del pulsante nella pagina di accesso
OIDC_LABEL=SSO

# false = accetta il certificato del provider senza verificarlo.
# Da usare solo come ultima spiaggia: la strada giusta per una CA interna
# è montare il certificato e puntarci NODE_EXTRA_CA_CERTS.
OIDC_TLS_REJECT_UNAUTHORIZED=true

# ── Importazione CAD ─────────────────────────────────────
# Il DXF lo legge il browser e non tocca queste impostazioni. Servono solo
# per i formati binari (oggi il DWG), che vanno convertiti sul server.
# L'immagine include già dwg2dxf di LibreDWG: di norma non serve altro.

# Comando di conversione alternativo. {in} e {out} vengono sostituiti.
#   CAD_CONVERT_CMD=/opt/mio-convertitore --from {in} --to {out}
CAD_CONVERT_CMD=

# ODA File Converter, se installato a parte: regge i DWG recenti meglio di
# LibreDWG, ma è proprietario e non può stare dentro l'immagine.
#   ODA_CONVERTER_PATH=/usr/bin/ODAFileConverter
ODA_CONVERTER_PATH=

# Tempo massimo per una conversione, in millisecondi
CAD_CONVERT_TIMEOUT_MS=120000

# ── Convertitore DWG (solo in fase di build) ─────────────
# 0 = usa il dwg2dxf già pronto in backend/vendor/bin/ (default: x86_64,
# statico). 1 = compila LibreDWG durante la costruzione dell'immagine,
# necessario su architetture diverse o per cambiare versione.
DWG_BUILD=0

# Quanti lavori in parallelo per compilare LibreDWG. Se la build muore
# senza messaggio è quasi sempre memoria: metti 1.
DWG_JOBS=2

# 1 = la costruzione dell'immagine fallisce se il convertitore non esce,
# invece di proseguire senza. Utile per accorgersene subito.
DWG_REQUIRED=0

# Versione di LibreDWG da compilare
LIBREDWG_VERSION=0.14
